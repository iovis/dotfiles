{
  "$schema": "https://opencode.ai/v2/cli.json",
  "animations": true,
  "attention": {
    "notifications": true
  },
  "cursor": {
    "blinking": false
  },
  "keybinds": {
    "prompt.editor": "alt+e",
    "session.list": "alt+l",
    "session.sidebar.toggle": "ctrl+s"
  },
  "prompt": {
    "image_preview": true,
    "paste": "compact"
  },
  "scroll": {
    "acceleration": true
  },
  "session": {
    "sidebar": "hide",
    "thinking": "hide"
  },
  "terminal": {
    "copy": "select"
  },
  "theme": {
    "name": "system"
  },
  "tabs": {
    "mode": "auto"
  }
}
