{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "cursor": {
    "blinking": false
  },
  "session": {
    "sidebar": "hide",
    "thinking": "hide"
  },
  "tabs": {
    "mode": "off",
    "layout": "vertical",
    "scope": "cwd",
    "indicators": "status"
  },
  "scroll": {
    "acceleration": true
  },
  "prompt": {
    "image_preview": true,
    "paste": "compact"
  },
  "attention": {
    "notifications": true
  },
  "terminal": {
    "copy": "select"
  },
  "animations": true
}
