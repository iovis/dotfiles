#!/usr/bin/env bash

if [[ $# -ne 1 ]]; then
  >&2 echo "usage: $0 FILENAME[:LINENO][:IGNORED]"
  exit 1
fi

file=${1/#\~\//$HOME/}

center=0
if [[ ! -r $file ]]; then
  if [[ $file =~ ^(.+):([0-9]+)\ *$ ]] && [[ -r ${BASH_REMATCH[1]} ]]; then
    file=${BASH_REMATCH[1]}
    center=${BASH_REMATCH[2]}
  elif [[ $file =~ ^(.+):([0-9]+):[0-9]+\ *$ ]] && [[ -r ${BASH_REMATCH[1]} ]]; then
    file=${BASH_REMATCH[1]}
    center=${BASH_REMATCH[2]}
  fi
fi

mime_type=$(file --brief --dereference --mime -- "$file")

can_preview_images=0
if [[ -n $KITTY_WINDOW_ID || -n $GHOSTTY_RESOURCES_DIR ]] && command -v kitten >/dev/null; then
  can_preview_images=1
fi

dim=${FZF_PREVIEW_COLUMNS}x${FZF_PREVIEW_LINES}

if [[ $dim == x ]]; then
  dim=$(stty size </dev/tty | awk '{print $2 "x" $1}')
elif ! [[ $KITTY_WINDOW_ID ]] && ((FZF_PREVIEW_TOP + FZF_PREVIEW_LINES == $(stty size </dev/tty | awk '{print $1}'))); then
  # Avoid scrolling when the image touches the bottom of the screen
  # * https://github.com/junegunn/fzf/issues/2544
  dim=${FZF_PREVIEW_COLUMNS}x$((FZF_PREVIEW_LINES - 1))
fi

if [[ $mime_type =~ image/ ]]; then
  if ((can_preview_images)); then
    kitten icat --transfer-mode=memory --unicode-placeholder --stdin=no --place="$dim@0x0" "$file"
  else
    file -- "$file"
  fi
elif [[ $mime_type =~ video/ ]]; then
  if ((can_preview_images)); then
    ffmpegthumbnailer -i "$file" -o - -s 960 -t 50 -c png 2>/dev/null |
      kitten icat --transfer-mode=memory --unicode-placeholder --stdin=yes --place="$dim@0x0"
  else
    file -- "$file"
  fi
else
  # If the file is a directory, list its contents
  if [[ -d $file ]]; then
    eza --color=always --icons=always -1a --group-directories-first -- "$file"
  elif [[ $mime_type =~ =binary ]]; then
    file -- "$file"
  else
    bat --style="${BAT_STYLE:-numbers}" --color=always --pager=never --highlight-line="$center" -- "$file"
  fi
fi
