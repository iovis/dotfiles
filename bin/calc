#!/usr/bin/env bash

case $(uname -s) in
Darwin) COPY_CMD="printf '%s' {} | pbcopy" ;;
Linux) COPY_CMD="wl-copy {}" ;;
*)
  echo "Unsupported operating system: $(uname -s)" >&2
  exit 1
  ;;
esac

NUMBAT_CMD="numbat --color=always -e"
INITIAL_QUERY="$*"

fzf \
  --prompt="    " \
  --disabled \
  --gutter=" " \
  --pointer=" " \
  --wrap \
  --ansi \
  --info=hidden \
  --separator=" " \
  --reverse \
  --wrap \
  --wrap-sign="" \
  --bind="start:reload:$NUMBAT_CMD {q} 2>&1" \
  --bind="change:reload:sleep 0.1; $NUMBAT_CMD {q} 2>&1" \
  --bind="enter:execute-silent($COPY_CMD)+abort" \
  --color=current-bg:-1 \
  --no-preview \
  --query="$INITIAL_QUERY"
