#!/usr/bin/env bash

search_roots=("$HOME")

case "$(uname -s)" in
Darwin)
  open_action='open {+}'
  terminal_action='open -na Ghostty.app --args --working-directory={}'
  file_manager_action='open -R {}'
  media_action='open -a IINA {+}'
  copy_action="printf '%s\\n' {+} | pbcopy && osascript -e 'display notification \"Copied path to clipboard\" with title \"fn\"'"
  ;;
Linux)
  [[ -d /run/media ]] && search_roots+=(/run/media)
  open_action='setsid -f xdg-open {}'
  terminal_action='setsid -f ghostty --working-directory={}'
  file_manager_action='setsid -f nautilus {+}'
  media_action='setsid -f mpv --autocreate-playlist=filter --shuffle --loop-playlist=inf {+}'
  copy_action='wl-copy {+} && notify-send --icon edit-paste "Copied path to clipboard"'
  ;;
*)
  echo "Unsupported operating system: $(uname -s)" >&2
  exit 1
  ;;
esac

fd_common=(fd --exclude node_modules --exclude public --exclude src --exclude target --exclude Library --exclude Applications)
fd_folders=("${fd_common[@]}" --type d --max-depth 4 . "${search_roots[@]}")
fd_files=("${fd_common[@]}" --type f . "${search_roots[@]}")

printf -v fd_folders_command '%q ' "${fd_folders[@]}"
printf -v fd_files_command '%q ' "${fd_files[@]}"

TRANSFORMER="
  test \"\$FZF_INPUT_LABEL\" = ' folders ' &&
    echo \"change-input-label( files )+reload($fd_files_command)\" ||
    echo \"change-input-label( folders )+reload($fd_folders_command)\"
"

INITIAL_QUERY="${*:-}"
"${fd_folders[@]}" | fzf \
  --prompt="❯ " \
  --gutter=" " \
  --header-border \
  --input-border \
  --input-label=" folders " \
  --list-border \
  --info=inline-right \
  --reverse \
  --multi \
  --bind="ctrl-g:transform:$TRANSFORMER" \
  --bind="enter:execute-silent($open_action)+abort" \
  --bind="alt-enter:execute-silent($terminal_action)+abort" \
  --bind="alt-e:execute(nvim {+})" \
  --bind="alt-y:become(yazi {+})" \
  --bind="alt-o:execute-silent($file_manager_action)+abort" \
  --bind="alt-l:execute-silent($terminal_action)+abort" \
  --bind="alt-m:execute-silent($media_action)+abort" \
  --bind="ctrl-o:execute-silent($copy_action)+abort" \
  --bind=ctrl-n:page-down,ctrl-p:page-up \
  --bind=alt-p:toggle-preview \
  --bind='alt-r:change-preview-window(down|right)' \
  --preview="fzf-preview {}" \
  --preview-window=right \
  --color=border:black \
  --color=info:black \
  --color=input-border:blue \
  --query="$INITIAL_QUERY" || true
