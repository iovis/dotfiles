#!/usr/bin/env bash

status=$(screenrecord --status 2>/dev/null) || status='{"state":"idle"}'

indicator=$(jq -cn --argjson status "$status" '
  ($status.state // "idle") as $state
  | {
      selecting: "Choosing recording source",
      recording: "Recording",
      saving: "Saving recording"
    }[$state] as $label
  | if $label == null then {text: ""}
    else {
      text: "  ",
      tooltip: ($label
        + (if ($status.file // "") == "" then ""
           else "\n" + ($status.file | tostring | @html) end)
        + "\nLeft click: stop\nRight click: controls"),
      class: "active"
    } end
' 2>/dev/null) || indicator='{"text":""}'

printf '%s\n' "$indicator"
