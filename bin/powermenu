#!/usr/bin/env bash

fzf_command() {
  fzf \
    --prompt="❯ " \
    --gutter=" " \
    --info=hidden \
    --highlight-line \
    --reverse \
    --bind="j:down,k:up,q:abort" \
    --no-preview
}

usage() {
  printf "Usage: %s [suspend|shutdown|reboot|logout]\n" "${0##*/}" >&2
}

if (($# > 1)); then
  usage
  exit 2
fi

if (($# == 0)); then
  action=$(printf "suspend\nshutdown\nreboot\nlogout" | fzf_command) || exit 0
else
  action=$1
fi

case $action in
"logout") exec uwsm-app -- hyprshutdown -t logout ;;
"reboot") exec uwsm-app -- hyprshutdown -t reboot --post-cmd "systemctl reboot" ;;
"shutdown") exec uwsm-app -- hyprshutdown -t shutdown --post-cmd "systemctl poweroff" ;;
"suspend") exec systemctl suspend ;;
*)
  usage
  exit 2
  ;;
esac
