#!/usr/bin/env bash

OUTPUT_DIR="${XDG_VIDEOS_DIR:-}"

if [[ -z "$OUTPUT_DIR" ]]; then
  OUTPUT_DIR=$(xdg-user-dir VIDEOS 2>/dev/null) || OUTPUT_DIR="$HOME/Videos"
  [[ -n "$OUTPUT_DIR" ]] || OUTPUT_DIR="$HOME/Videos"
fi

DESKTOP_AUDIO="true"
STOP_RECORDING="false"

usage() {
  printf 'Usage: %s [--without-desktop-audio] [--stop-recording]\n' "${0##*/}"
}

for arg in "$@"; do
  case "$arg" in
  --without-desktop-audio) DESKTOP_AUDIO="false" ;;
  --stop-recording) STOP_RECORDING="true" ;;
  -h | --help)
    usage
    exit
    ;;
  *)
    printf 'Unknown option: %s\n' "$arg" >&2
    usage >&2
    exit 2
    ;;
  esac
done

watch_screenrecording() {
  local recorder_pid="$1"

  while kill -0 "$recorder_pid" 2>/dev/null; do
    sleep 0.2
  done

  refresh_screenrecording_indicator
}

show_saved_notification() {
  local action

  action=$(notify-send \
    --icon org.gnome.Snapshot-symbolic \
    --action="default=Open Folder" \
    "Screen recording saved" \
    "$OUTPUT_DIR" \
    -t 5000)

  if [[ "$action" == "default" ]]; then
    setsid -f xdg-open "$OUTPUT_DIR" >/dev/null 2>&1
  fi
}

start_screenrecording() {
  local filename
  local -a recorder_args
  local recorder_pid

  if ! mkdir -p "$OUTPUT_DIR"; then
    notify-send --icon org.gnome.Snapshot-symbolic "Could not create screen recording directory: $OUTPUT_DIR" -u critical -t 3000
    return 1
  fi

  filename="$OUTPUT_DIR/screenrecording-$(date +'%Y-%m-%d_%H-%M-%S').mp4"
  recorder_args=(-w portal -f 60 -fallback-cpu-encoding yes -o "$filename" -ac aac)
  [[ "$DESKTOP_AUDIO" == "true" ]] && recorder_args+=(-a default_output)

  gpu-screen-recorder "${recorder_args[@]}" &
  recorder_pid=$!

  sleep 0.2

  if ! kill -0 "$recorder_pid" 2>/dev/null; then
    notify-send --icon org.gnome.Snapshot-symbolic "Screen recording error" "Failed to start screen recording." -u critical -t 5000
    return 1
  fi

  watch_screenrecording "$recorder_pid" >/dev/null 2>&1 &

  refresh_screenrecording_indicator
}

stop_screenrecording() {
  # If share picker is still open, user probably cancelled recording
  if pgrep -f "^hyprland-share-picker" >/dev/null; then
    pkill -f "^hyprland-share-picker"
    refresh_screenrecording_indicator
    exit
  fi

  pkill -SIGINT -f "^gpu-screen-recorder" # SIGINT required to save video properly

  # Wait a maximum of 5 seconds to finish before hard killing
  local count=0
  while pgrep -f "^gpu-screen-recorder" >/dev/null && [ $count -lt 50 ]; do
    sleep 0.1
    count=$((count + 1))
  done

  if pgrep -f "^gpu-screen-recorder" >/dev/null; then
    pkill -KILL -f "^gpu-screen-recorder"
    refresh_screenrecording_indicator
    notify-send --icon org.gnome.Snapshot-symbolic "Screen recording error" "Recording process had to be force-killed. Video may be corrupted." -u critical -t 5000
  else
    refresh_screenrecording_indicator
    show_saved_notification >/dev/null 2>&1 &
  fi
}

refresh_screenrecording_indicator() {
  pkill -RTMIN+8 waybar 2>/dev/null || true
}

if pgrep -f "^gpu-screen-recorder" >/dev/null; then
  stop_screenrecording
  exit
fi

if [[ "$STOP_RECORDING" == "false" ]]; then
  start_screenrecording
else
  exit 1
fi
