#!/usr/bin/env bash

refresh_waybar() {
  pkill -RTMIN+9 waybar >/dev/null 2>&1 || true
}

if systemctl --user is-active --quiet hypridle.service; then
  if systemctl --user stop hypridle.service; then
    echo "󰈈  Idle inhibit on"
  else
    notify-send --icon=view-conceal-symbolic -u critical "Failed to stop hypridle"
  fi
else
  if systemctl --user start hypridle.service; then
    echo "󰈉  Idle inhibit off"
  else
    notify-send --icon=view-reveal-symbolic -u critical "Failed to start hypridle"
  fi
fi

refresh_waybar
