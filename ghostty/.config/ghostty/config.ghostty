# ghostty +show-config --default --docs
confirm-close-surface = false
copy-on-select = clipboard
cursor-style-blink = false
mouse-hide-while-typing = true
mouse-scroll-multiplier = precision:1,discrete:2
shell-integration-features = cursor,no-sudo,title,ssh-env,no-ssh-terminfo,path

window-padding-balance = true
window-padding-x = 8
window-padding-y = 8

font-family = FiraCode Nerd Font
font-size = 23

background = #000000
background-blur = true
background-opacity = 0.6

macos-option-as-alt = true
macos-titlebar-style = hidden
macos-window-buttons = hidden

theme = Catppuccin Frappe
selection-background = #292c3c
selection-foreground = #c6d0f5
palette = 9=#e78284
palette = 10=#a6d189
palette = 11=#e5c890
palette = 12=#8caaee
palette = 13=#f4b8e4
palette = 14=#81c8be

config-file = keymap.ghostty
config-file = ?local.ghostty
