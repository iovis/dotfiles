#!/usr/bin/env bash

# /bin/bash -c "$(curl --proto '=https' --tlsv1.2 -LsSf https://raw.githubusercontent.com/iovis/dotfiles/master/scripts/macOS)"
set -euo pipefail

export DOTFILES="$HOME/.dotfiles"
export LOCAL_BIN="${LOCAL_BIN:-$HOME/.local/bin}"
export PATH="$LOCAL_BIN:$PATH"

echo "[$(date '+%Y-%m-%d %H:%M')] Installing Libraries"
if [ ! -x /opt/homebrew/bin/brew ]; then
  echo "[$(date '+%Y-%m-%d %H:%M')] Installing Homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

if [ ! -d "$DOTFILES" ]; then
  echo "[$(date '+%Y-%m-%d %H:%M')] Installing Dotfiles"
  git clone https://github.com/iovis/dotfiles "$DOTFILES"
fi

brew bundle --file "$DOTFILES/brew/Brewfile"

echo "[$(date '+%Y-%m-%d %H:%M')] Stow"
cd "$DOTFILES" || exit
stow --restow aerc aerospace bat brew fish fzf ghostty git hammerspoon kitty lazygit llvm mise muxi nvim pry starship stylua tldr tmux vim wezterm yazi
cd || exit

echo "[$(date '+%Y-%m-%d %H:%M')] Installing mise"
if ! command -v mise >/dev/null 2>&1; then
  curl https://mise.run | sh
fi

mise install -y

echo "[$(date '+%Y-%m-%d %H:%M')] Installing rust"
if [ ! -f "$HOME/.cargo/env" ]; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
fi

if [ -f "$HOME/.cargo/env" ]; then
  # shellcheck disable=SC1091 # dynamic path created by rustup installer
  . "$HOME/.cargo/env"
else
  echo "rustup env file missing at $HOME/.cargo/env" >&2
  exit 1
fi

command -v cargo >/dev/null 2>&1 || {
  echo "cargo not found after rustup setup" >&2
  exit 1
}

cargo install cargo-binstall
# shellcheck disable=SC2046 # curated newline-delimited crate list
cargo binstall -y $(cat "$DOTFILES/default/crates")

echo "[$(date '+%Y-%m-%d %H:%M')] macOS Settings"
# General
defaults write -g NSUseSpellCheckerForCompletions -bool false # Disable Escape completion menu
defaults write -g ApplePressAndHoldEnabled -bool false        # Enable key repeat
defaults write -g NSWindowShouldDragOnGesture -bool true      # Drag windows from anywhere with ctrl+cmd+click

# Disable automatic transformations
defaults write -g NSAutomaticSpellingCorrectionEnabled -bool false
defaults write -g NSAutomaticCapitalizationEnabled -bool false
defaults write -g NSAutomaticPeriodSubstitutionEnabled -bool false
defaults write -g NSAutomaticQuoteSubstitutionEnabled -bool false
defaults write -g NSAutomaticDashSubstitutionEnabled -bool false

# Finder settings
defaults write -g AppleShowAllExtensions -bool true
defaults write com.apple.finder ShowPathbar -bool true
defaults write com.apple.finder ShowStatusBar -bool true

# Dock
defaults write com.apple.dock mru-spaces -bool false   # Don't reorder spaces
defaults write com.apple.dock show-recents -bool false # Don't show recents in Dock
defaults write com.apple.dock showhidden -bool true    # Translucent hidden apps in Dock
killall Dock

echo "[$(date '+%Y-%m-%d %H:%M')] Installation ended"
